import pygame

pygame.init()

WIDTH = 800
HEIGHT = 600
CELL = 20

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Неоновая змейка")

NEON_BLUE = (0, 240, 255)

snake_x = 400
snake_y = 300

running = True

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    screen.fill((5, 8, 25))

    pygame.draw.rect(
        screen,
        NEON_BLUE,
        (snake_x, snake_y, CELL, CELL)
    )

    pygame.display.flip()

pygame.quit()
