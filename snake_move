import pygame

pygame.init()

WIDTH = 800
HEIGHT = 600
CELL = 20

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Неоновая змейка")

NEON_BLUE = (0, 240, 255)

snake = [
    [400,300],
    [380,300],
    [360,300]
]


derection_x = 20
derection_y = 0

running = True

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    new_x = snake[0][0] + derection_x
    new_y = snake[0][1] + derection_y

    

    screen.fill((5, 8, 25))
    for part in snake:
        pygame.draw.rect(
            screen,
            NEON_BLUE,
            (part[0], part[1], CELL, CELL),
            border_radius = 5
        )
    

    pygame.display.flip()

pygame.quit()
